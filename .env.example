# Built by Kiril Ivlev · https://www.linkedin.com/in/kiril-ivlev/
# QC Portal — proprietary. Not licensed for redistribution or resale.

# Signs every session. Long and random — generate with `openssl rand -hex 32`.
# With this unset the app fails shut: nobody can sign in at all. Rotating it signs everyone out.
SESSION_SECRET=

# The same Supabase project QC Command (Reply Radar) uses. The portal reads its rr_* tables (scoped) and
# writes only its own qc_portal_* tables, plus inbox replies and analytics-refresh requests.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# QC Brain (GitHub repo jsbiv18/qc-growth-os): the Brain, Messaging and Weekly calls tabs.
BRAIN_GITHUB_TOKEN=

# Lays out Brain documents for reading.
ANTHROPIC_API_KEY=

# The health watchdog (/api/cron/health-alert, every 5 minutes via vercel.json).
CRON_SECRET=
HEALTH_ALERT_SLACK_WEBHOOK=

# Optional. HeyReach API base for sending inbox replies (defaults to the public API).
# HEYREACH_API_BASE=

# Optional. Set when serving from a custom domain so the cookie covers it, e.g. .qcgrowth.com
# PORTAL_COOKIE_DOMAIN=
# PORTAL_ROOT_DOMAIN=
